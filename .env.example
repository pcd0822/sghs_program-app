# 이 파일을 복사해 .env.local 을 만들고 값을 채운다. (.env.local 은 깃허브에 올라가지 않음)
# 값은 파이어베이스 콘솔 → 프로젝트 설정 → 내 앱(웹) → SDK 설정 및 구성 에 있다.

# true 면 내 컴퓨터 시험장(에뮬레이터)에 연결. 아래 값이 비어 있어도 된다.
VITE_USE_EMULATORS=true

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sghs-program-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sghs-program-app
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
